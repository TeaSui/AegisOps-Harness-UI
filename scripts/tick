#!/usr/bin/env python3
"""Tick every acceptance criterion of one ticket (after its tests showed them): scripts/tick T3"""
import re, sys, pathlib
p = pathlib.Path('docs/specs/harness-console/tickets.md'); s = p.read_text(); t = sys.argv[1]
m = re.search(rf'(## {t}:.*?)(?=\n## T|\Z)', s, re.S)
p.write_text(s.replace(m.group(1), m.group(1).replace('- [ ]', '- [x]')))
